  "temiz": "CREATE VIEW toplama_temiz AS\nSELECT DISTINCT\n  satir_id,\n  tarih,\n  vardiya,\n  UPPER(TRIM(bolge)) AS bolge,\n  LOWER(TRIM(duzen)) AS duzen,\n  toplayici,\n  sure_sn\nFROM toplama_ham\nWHERE sure_sn IS NOT NULL\n  AND sure_sn BETWEEN 5 AND 600;",
  "ozet": "SELECT duzen,\n       COUNT(*) AS satir,\n       ROUND(AVG(sure_sn), 2) AS ort_sure\nFROM toplama_temiz\nGROUP BY duzen\nORDER BY duzen;",
